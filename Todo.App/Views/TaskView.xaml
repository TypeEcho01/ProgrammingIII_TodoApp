<UserControl x:Class="Todo.App.Views.TaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Todo.App.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">

    <Grid>
        <Border BorderBrush="Gray" BorderThickness="2" CornerRadius="8" Margin="4" Padding="8" Background="White">
            <StackPanel>
                <Label Content="{Binding StatusString}" FontSize="12" FontWeight="Thin"/>
                <Label Content="{Binding Name}" FontSize="20" FontWeight="Bold"/>
                <Label Content="{Binding Description}" FontSize="16"/>
                <Label Content="{Binding DueDateString}" FontSize="14" FontStyle="Italic"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label Content="Edit:"/>
                    <Button Command="{Binding EditName}" Content="Name"/>
                    <Button Command="{Binding EditDescription}" Content="Description"/>
                    <Button Command="{Binding EditDueDate}" Content="Due Date"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label Content="Actions:"/>
                    <Button Command="{Binding ToggleCompletion}" 
                            Content="{Binding ToggleCompletionString}" />
                    <Button Content="Delete"
                        Command="{Binding DataContext.DeleteTask, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                    />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label Content="Move:"/>
                    <Button Content="Up"
                        Command="{Binding DataContext.MoveUp, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}">
                    </Button>
                    <Button Content="Down"
                        Command="{Binding DataContext.MoveDown, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}">
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>