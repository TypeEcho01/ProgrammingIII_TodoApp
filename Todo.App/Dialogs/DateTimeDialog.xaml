<Window x:Class="Todo.App.Dialogs.DateTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Todo.App.Dialogs"
        mc:Ignorable="d"
        Title="DateTime Dialog" Height="200" Width="300"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel>
            <Label Content="Enter Date:"></Label>
            <DatePicker x:Name="Date_Input" SelectedDateFormat="Long" FirstDayOfWeek="Monday"></DatePicker>

            <Label Content="Enter Time:"></Label>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBox x:Name="Hour_Input" Text="11"></TextBox>
                <Label Content=":"></Label>
                <TextBox x:Name="Minute_Input" Text="59"></TextBox>
                <Button x:Name="Meridiem_Button" Content="PM" Click="Meridiem_Button_Click"></Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="Enter_Button" Content="Enter" Click="Enter_Button_Click"></Button>
                <Button x:Name="Cancel_Button" Content="Cancel" Click="Cancel_Button_Click"></Button>
                <Button x:Name="None_Button" Content="None" Click="None_Button_Click"></Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
